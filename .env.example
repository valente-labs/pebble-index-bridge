# Copy this file to .env and replace every invalid sentinel before starting.
# Keep .env mode 0600. Prefer secret files over direct secret environment values.

BRIDGE_TOKEN_FILE=./secrets/bridge-token.txt
GROKBOT_WEBHOOK_URL_FILE=./secrets/grok-webhook-url.txt
GROKBOT_WEBHOOK_KEY_FILE=./secrets/grok-webhook-key.txt

# The container deployment mounts a private writable volume at /data. The
# database holds every accepted transcription in full, so the volume and any
# backup of it must stay private. Logs and status output never contain speech.
DB_PATH=/data/index-bridge.sqlite3

REQUEST_TIMEOUT_SECONDS=15
MAX_REQUEST_BYTES=65536
MAX_TRANSCRIPTION_CHARS=8000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Capacity limits. Reaching one makes intake return HTTP 503. Nothing is ever
# deleted automatically; delivered events still count toward MAX_RECORDS and
# MAX_BYTES. See docs/deployment.md, "Capacity maintenance".
MAX_PENDING=1000
MAX_RECORDS=10000
MAX_BYTES=67108864
# Replace bridge.example.invalid with the HTTPS host used by your front end.
ALLOWED_HOSTS=bridge.example.invalid,localhost,127.0.0.1
